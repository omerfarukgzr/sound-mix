{
  "manifest_version": 3,
  "name": "Tab Mixer",
  "version": "1.0.0",
  "description": "Chrome'daki videoları macOS menü çubuğundaki Tab Mixer uygulamasından oynatır, durdurur ve seslerini ayarlar.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "webNavigation",
    "favicon"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "tracker.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "bridge.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    }
  ]
}
